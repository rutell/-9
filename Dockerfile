# 1. Используем официальный образ с Python 3.11 (стабильная версия)
FROM python:3.11-slim

# 2. Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# 3. Копируем файл с зависимостями и устанавливаем их
#    --no-cache-dir нужен, чтобы уменьшить размер финального образа
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. Копируем весь код приложения в контейнер
COPY . .

# 5. Объявляем порт, который будет слушать наше приложение
EXPOSE 8000

# 6. Команда для запуска приложения
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
